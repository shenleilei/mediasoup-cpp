{
  "uid": "mediasoup-infrastructure",
  "title": "Infrastructure",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})) * 100",
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Receive/Transmit Bytes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "rx {{instance}} {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "tx {{instance}} {{device}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Threads / Workers / Rooms",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "mediasoup_sfu_worker_threads",
          "legendFormat": "worker threads {{instance}}"
        },
        {
          "expr": "mediasoup_sfu_available_worker_threads",
          "legendFormat": "available worker threads {{instance}}"
        },
        {
          "expr": "mediasoup_sfu_workers",
          "legendFormat": "workers {{instance}}"
        },
        {
          "expr": "mediasoup_sfu_rooms",
          "legendFormat": "rooms {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Control Plane Queue / Wait Signals",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "mediasoup_sfu_worker_thread_queue_depth",
          "legendFormat": "queue depth thread {{thread_id}}"
        },
        {
          "expr": "mediasoup_sfu_worker_thread_queue_peak_depth",
          "legendFormat": "queue peak thread {{thread_id}}"
        },
        {
          "expr": "mediasoup_sfu_worker_thread_avg_task_wait_us",
          "legendFormat": "avg wait us thread {{thread_id}}"
        },
        {
          "expr": "mediasoup_sfu_dispatch_rooms",
          "legendFormat": "dispatch rooms {{instance}}"
        },
        {
          "expr": "mediasoup_sfu_stale_request_drops_total",
          "legendFormat": "stale requests total {{instance}}"
        },
        {
          "expr": "mediasoup_sfu_rejected_client_stats_total",
          "legendFormat": "rejected clientStats total {{instance}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
